# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080

DATABASE_URL=postgres://veo:veo@localhost:5432/veo
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

ARTIFACT_DIR=/data/artifacts

# stub = local fake providers (R1 pipeline testing). live = real provider adapters (R2+).
PROVIDER_MODE=stub

# R2: ElevenLabs API key for real TTS / SFX / voice design / cloning.
# Leave empty to fall back to the stub provider. Never commit this file.
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# --- R3: video/image/LLM providers (empty = chain falls through to stub) ---
# GEMINI_API_KEY=your-gemini-key        # also accepts GOOGLE_API_KEY
# FAL_KEY=your-fal-key
# REPLICATE_API_TOKEN=your-replicate-token
# TOGETHER_API_KEY=your-together-key
# SELF_HOSTED_API_KEY=optional-key-for-your-own-endpoint

# --- R4: YouTube Data API v3 key (channel analyzer, video breakdown, niche finder) ---
# YOUTUBE_API_KEY=<redacted>
# (Any of the above can also be set from the API Keys page in the UI;
# the UI-stored value takes precedence over the env var.)
WORKER_CONCURRENCY=4
